-- 9. قسم الوظائف المتطورة
local currentBeam, att0, att1
local function drawLineToCoin(targetCoin)
    if currentBeam then currentBeam:Destroy() end
    if att0 then att0:Destroy() end
    if att1 then att1:Destroy() end
    
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and targetCoin and targetCoin.Parent then
        att0 = Instance.new("Attachment", char.HumanoidRootPart)
        att1 = Instance.new("Attachment", targetCoin)
        
        currentBeam = Instance.new("Beam")
        currentBeam.Attachment0 = att0
        currentBeam.Attachment1 = att1
        currentBeam.Color = ColorSequence.new(Color3.fromRGB(160, 80, 255))
        currentBeam.Width0 = 0.25
        currentBeam.Width1 = 0.25
        currentBeam.FaceCamera = true
        currentBeam.Parent = char.HumanoidRootPart
    end
end

local function clearLine()
    if currentBeam then currentBeam:Destroy() currentBeam = nil end
    if att0 then att0:Destroy() att0 = nil end
    if att1 then att1:Destroy() att1 = nil end
end

local function getNearestCoin()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = char.HumanoidRootPart.Position
    
    local nearestCoin = nil
    local shortestDist = math.huge
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "CoinContainer" then
            for _, coin in pairs(obj:GetChildren()) do
                if coin:IsA("BasePart") and coin:FindFirstChild("TouchInterest") then
                    local dist = (rootPos - coin.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestCoin = coin
                    end
                end
            end
        end
    end
    return nearestCoin
end

RunService.Stepped:Connect(function()
    if getgenv().AutoFarm and localPlayer.Character then
        for _, part in pairs(localPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

local function isBagFull()
    local pGui = localPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end
    for _, v in pairs(pGui:GetDescendants()) do
        if v:IsA("TextLabel") and v.Visible then
            local current, max = string.match(v.Text, "(%d+)%s*/%s*(%d+)")
            if current and max and tonumber(max) >= 40 and tonumber(current) >= tonumber(max) then
                return true
            end
        end
    end
    return false
end

local function moveToCoin(targetCoin)
    local character = localPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") and targetCoin and targetCoin.Parent then
        drawLineToCoin(targetCoin)
        local rootPart = character.HumanoidRootPart
        local distance = (rootPart.Position - targetCoin.Position).Magnitude
        local duration = distance / farmSpeed
        
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCoin.CFrame})
        tween:Play()
        
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if not getgenv().AutoFarm or not targetCoin.Parent or not targetCoin:FindFirstChild("TouchInterest") then
                tween:Cancel()
                break
            end
            task.wait(0.05)
        end
        clearLine()
    end
end

task.spawn(function()
    while task.wait(0.2) do
        if getgenv().AutoFarm then
            if getgenv().AutoReset and isBagFull() then
                if localPlayer.Character then
                    localPlayer.Character:BreakJoints()
                    task.wait(4)
                end
            else
                local targetCoin = getNearestCoin()
                if targetCoin then
                    moveToCoin(targetCoin)
                    if not targetCoin:FindFirstChild("TouchInterest") or not targetCoin.Parent then
                        sessionCoins = sessionCoins + 1
                        CoinsLabel.Text = "العملات المجمعة: " .. tostring(sessionCoins)
                    end
                end
            end
        else
            clearLine()
        end
    end
end)

